{
    "name": "server",
    "version": "1.0.0",
    "description": "",
    "main": "server.js",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "start": "node server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "author": "",
    "license": "ISC",
    "config": {
        "mongodbMemoryServer": {
            "_comment": "Stops the postinstall hook downloading a ~148MB mongod on every install. A plain `npm ci` in a deploy build installs devDependencies unless NODE_ENV=production is set at BUILD time, which most hosts do not do \u2014 so the binary was being pulled into production images that never run a test. Tests download it on first use instead; CI caches it via MONGOMS_DOWNLOAD_DIR. See DEPLOYMENT.md.",
            "disablePostinstall": "true"
        }
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "connect-mongo": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^16.0.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "express-session": "^1.19.0",
        "mongo-sanitize": "^1.1.0",
        "mongodb": "^7.5.0",
        "nodemailer": "^9.0.5",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.9.0",
        "mongodb-memory-server": "^11.2.0",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "vitest": "^4.1.10"
    }
}
