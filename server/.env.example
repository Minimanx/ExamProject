NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:8080,http://localhost:5000
MONGODB_URI=mongodb://username:password@mongodb-internal-host:27017/FlixDrive?authSource=admin
SESSION_SECRET=replace-with-at-least-32-random-bytes
OMDB_API_KEY=replace-with-omdb-api-key
EMAIL_USER=replace-with-gmail-address
EMAIL_PASSWORD=replace-with-gmail-app-password

# Require an invite code to sign up. See DEPLOYMENT.md.
INVITE_ONLY=false

# Hosting limits. See DEPLOYMENT.md; unset means the defaults below.
# MAX_SCHEDULING_WINDOW_HOURS=24
# MAX_SEATS=99
# MAX_EVENTS_PER_OWNER=1
# HUB_CAPACITY=60

# Voice (Phase 6). The mesh needs STUN to find a direct route, and TURN for the
# pairs that cannot get one — symmetric NAT and restrictive firewalls. Without
# TURN those calls never connect, and it looks like silence rather than an error.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:relay.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# A mesh is every participant connected to every other, so cost grows with the
# square of the group. This is a product constraint, not a tuning knob.
# VOICE_CAPACITY=5
