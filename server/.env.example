NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:8080,http://localhost:5000
MONGODB_URI=mongodb://username:password@mongodb-internal-host:27017/FlixDrive?authSource=admin
SESSION_SECRET=replace-with-at-least-32-random-bytes
OMDB_API_KEY=replace-with-omdb-api-key
EMAIL_USER=replace-with-gmail-address
EMAIL_PASSWORD=replace-with-gmail-app-password
SERVE_CLIENT=false
